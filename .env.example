# Supabase project URL. Local CLI default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable client key. Safe to expose in the browser.
# Local `supabase status` prints this as the anon key or the publishable key.
# Paste that value here. Never put the service_role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional, server-only. Not read by the Next.js app.
# Used by `npm run verify` if you want the script to delete its temporary upload.
# SUPABASE_SECRET_KEY=your-service-role-or-secret-key
