# Supabase project URL. Local CLI default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public client key. Either name works. `supabase status` prints both.
# Never put the service role or secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required for automated verification writes and the Stripe webhook.
# Local `supabase status` prints this as the secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias read by the server if SUPABASE_SERVICE_ROLE_KEY is unset.
# SUPABASE_SECRET_KEY=your-service-role-key

# Public site URL used in email links. Local default:
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Stripe. Leave blank until billing is turned on. See docs/MONETIZATION.md.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
# NEXT_PUBLIC_STRIPE_EMPLOYER_PRICE_ID=

# Email. Leave blank until SMTP or Resend is configured.
# RESEND_API_KEY=

# Automated license lookups. Leave blank to keep credentials in the admin queue.
# TRADEPROOF_API_KEY=
# TEXAS_OPEN_DATA_TOKEN=
